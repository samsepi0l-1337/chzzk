CHZZK_CLIENT_ID=your-client-id
CHZZK_CLIENT_SECRET=your-client-secret
CHZZK_CHANNEL_ID=target-streamer-channel-id
CHZZK_REDIRECT_URI=http://127.0.0.1:8080/chzzk/oauth/callback
# EC2 public callback example: CHZZK_AUTH_CALLBACK_BIND_HOST=0.0.0.0
# Required only for auth:web streamer-facing token bootstrap page.
CHZZK_AUTH_PAGE_SECRET=replace-with-random-page-secret
# Optional override for the URL shown by Minecraft /chzzk auth.
CHZZK_AUTH_URL=
# OAuth scopes: 후원 조회, 채팅 메시지 조회
CHZZK_TOKEN_STORE=.chzzk-tokens.json
CHZZK_OPENAPI_BASE_URL=https://openapi.chzzk.naver.com

MINECRAFT_WEBHOOK_URL=http://127.0.0.1:29371/chzzk/donations
MINECRAFT_WEBHOOK_SECRET=replace-with-shared-secret
WEBHOOK_MAX_ATTEMPTS=3
WEBHOOK_RETRY_DELAY_MS=500
