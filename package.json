{
  "private": true,
  "scripts": {
    "test": "npm --prefix bridge test",
    "build": "npm --prefix bridge run build",
    "docker:run": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/run-docker.ps1",
    "docker:build": "docker compose -f docker-compose.yml build",
    "docker:up": "docker compose -f docker-compose.yml up --build",
    "docker:paper:build": "docker compose -f docker-compose.paper.yml build",
    "docker:paper:up": "docker compose -f docker-compose.paper.yml up --build",
    "auth:url": "npm --prefix bridge run auth:url -- --env-file .env",
    "auth:login": "npm --prefix bridge run auth:login -- --env-file .env",
    "e2e:health": "npm --prefix bridge run e2e:health",
    "e2e:webhook": "npm --prefix bridge run e2e:webhook --",
    "e2e:check-env": "npm --prefix bridge run e2e:check-env",
    "aws:ec2:plan": "bash scripts/aws-ec2-provision.sh",
    "aws:ec2:provision": "AWS_EC2_APPLY=true bash scripts/aws-ec2-provision.sh",
    "aws:ec2:deploy": "bash scripts/aws-ec2-deploy.sh",
    "aws:ec2:verify": "bash scripts/aws-ec2-verify.sh",
    "aws:ec2:backup": "bash scripts/aws-ec2-backup.sh"
  }
}
